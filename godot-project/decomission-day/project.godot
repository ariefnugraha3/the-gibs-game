; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Decommission Day"
run/main_scene="res://src/scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Pal="*res://src/autoload/palette.gd"
Config="*res://src/autoload/config.gd"
SaveSystem="*res://src/autoload/save_system.gd"
AchievementManager="*res://src/autoload/achievement_manager.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
GameState="*res://src/autoload/game_state.gd"
SceneRouter="*res://src/autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
